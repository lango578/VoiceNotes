[Unit]
Description=VoiceNotes backend server (translation + optional Whisper ASR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voicenotes
Group=voicenotes
WorkingDirectory=/opt/voicenotes-server
EnvironmentFile=/opt/voicenotes-server/.env
Environment=HF_HOME=/opt/voicenotes-server/.cache
ExecStart=/opt/voicenotes-server/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
